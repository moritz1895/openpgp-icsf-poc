<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>ms.rohde</groupId>
    <artifactId>openpgp-icsf-poc</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>openpgp-icsf-poc</name>
    <description>PoC: Erweiterung einer proprietaeren HSM-Krypto-Bibliothek (ICSF/z-OS-Backend) um OpenPGP, ohne JCE/PKCS11</description>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <jspecify.version>1.0.1</jspecify.version>
        <archunit.version>1.5.0</archunit.version>
        <hexagonal-arch.version>1.0.0</hexagonal-arch.version>
        <bouncycastle.version>1.85</bouncycastle.version>
    </properties>

    <dependencies>
        <!-- Spring Boot core: nur fuer den schlanken CommandLineRunner-Demo-Adapter (@DrivingAdapter) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Log4j2 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>

        <!-- JSpecify -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>${jspecify.version}</version>
        </dependency>

        <!-- Jakarta Inject (JSR-330) -->
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
        </dependency>

        <!-- Hexagonal Architecture Annotations -->
        <dependency>
            <groupId>ms.rohde</groupId>
            <artifactId>hexagonal-arch-annotations</artifactId>
            <version>${hexagonal-arch.version}</version>
        </dependency>

        <!-- Hexagonal Architecture Spring Integration -->
        <dependency>
            <groupId>ms.rohde</groupId>
            <artifactId>hexagonal-arch-spring</artifactId>
            <version>${hexagonal-arch.version}</version>
        </dependency>

        <!-- OpenPGP-Paketformat/Framing (RFC 4880 / RFC 9580) - ausschliesslich fuer
             Paket-Serialisierung/-Parsing und Orchestrierung genutzt, NICHT fuer die
             eigentlichen kryptographischen Operationen. Die BouncyCastleProvider-JCE-Klasse
             wird in diesem Projekt bewusst nicht registriert/verwendet - siehe
             docs/technical/openpgp-hsm-bridge.md. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpg-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcutil-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>

        <!-- Test Dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>ms.rohde</groupId>
            <artifactId>hexagonal-arch-archunit</artifactId>
            <version>${hexagonal-arch.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- ms.rohde:hexagonal-arch-* wird nur in dieses interne Repository veroeffentlicht,
         nie zu Maven Central; fuer lokale Builds und den containerisierten Docker-Build
         erforderlich (siehe Dockerfile). -->
    <repositories>
        <repository>
            <id>internal-releases</id>
            <url>http://maven.home/releases</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${java.version}</release>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                        <arg>-Werror</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Siehe module-info.java-Kommentar: der Spring-Boot-Jar laeuft immer
                         ueber "java -jar" auf dem Classpath, nie auf dem Module-Path. Surefire
                         soll Testklassen konsistent dazu ebenfalls auf dem Classpath ausfuehren. -->
                    <useModulePath>false</useModulePath>
                    <argLine>
                        -XX:+EnableDynamicAgentLoading
                        --add-opens java.base/java.lang=ALL-UNNAMED
                        --add-opens java.base/java.util=ALL-UNNAMED
                        --add-opens java.base/java.lang.reflect=ALL-UNNAMED
                    </argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Diese Iteration liefert nur core/domain, core/app, ports/ und den
                         Dummy-Hsm-Adapter aus - der @SpringBootApplication-Hauptklasse
                         tragende CLI-Demo-Adapter (@DrivingAdapter) folgt erst in einer
                         Folge-Iteration (siehe Projektplan). Repackage bis dahin ueberspringen. -->
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
